<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Ledger — крипто-комьюнити</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<style>
  :root{
    --bg:#0F1420;
    --surface:#171D2E;
    --surface-raised:#1F2740;
    --line:#2A3350;
    --text:#EDEFF7;
    --text-dim:#8B93AC;
    --gold:#C9A227;
    --teal:#2DD4BF;
    --red:#E5626B;
    --radius:14px;
    --font-display:'Space Grotesk', 'Segoe UI', sans-serif;
    --font-mono:'IBM Plex Mono', 'Courier New', monospace;
    --font-body:'Inter', 'Segoe UI', sans-serif;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0; padding:0; height:100%; background:var(--bg); color:var(--text);
    font-family:var(--font-body); overscroll-behavior:none;}
  #app{display:flex; flex-direction:column; height:100vh; max-width:520px; margin:0 auto; position:relative;}

  /* ---------- Ticker ---------- */
  .ticker-wrap{background:var(--surface); border-bottom:1px solid var(--line); overflow:hidden; white-space:nowrap; flex-shrink:0;}
  .ticker{display:inline-block; padding:8px 0; font-family:var(--font-mono); font-size:12px; color:var(--text-dim);
    animation:scroll 28s linear infinite;}
  .ticker span{margin-right:28px;}
  .ticker .up{color:var(--teal);}
  .ticker .gold{color:var(--gold);}
  @keyframes scroll{from{transform:translateX(0);} to{transform:translateX(-50%);}}

  /* ---------- Header ---------- */
  header{padding:20px 20px 4px; flex-shrink:0;}
  .eyebrow{font-family:var(--font-mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:var(--gold);}
  h1{font-family:var(--font-display); font-size:26px; margin:6px 0 2px; font-weight:600; letter-spacing:-.01em;}
  .sub{color:var(--text-dim); font-size:13px; margin:0;}

  /* ---------- Screens ---------- */
  main{flex:1; overflow-y:auto; padding:16px 20px 90px;}
  .screen{display:none;}
  .screen.active{display:block; animation:fade .25s ease;}
  @keyframes fade{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}

  /* ---------- Onboarding ---------- */
  #onboarding{position:absolute; inset:0; background:var(--bg); display:none; flex-direction:column;
    justify-content:center; padding:32px 28px; z-index:20;}
  #onboarding.show{display:flex;}
  .node-graph{width:100%; max-width:280px; margin:0 auto 28px; display:block;}
  #onboarding h2{font-family:var(--font-display); font-size:28px; line-height:1.15; margin:0 0 12px; text-align:center;}
  #onboarding p{color:var(--text-dim); font-size:14px; text-align:center; line-height:1.5; margin:0 auto 32px; max-width:320px;}
  .cta{display:block; width:100%; padding:15px; border:none; border-radius:var(--radius); background:var(--gold);
    color:#161200; font-family:var(--font-display); font-weight:600; font-size:15px; cursor:pointer;}
  .cta:active{opacity:.85;}
  .ghost{background:none; border:none; color:var(--text-dim); font-size:13px; margin-top:14px; width:100%; cursor:pointer; font-family:var(--font-body);}

  /* ---------- Cards ---------- */
  .card{background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:16px; margin-bottom:12px;}
  .card-head{display:flex; align-items:center; gap:10px; margin-bottom:10px;}
  .avatar{width:36px; height:36px; border-radius:10px; background:var(--surface-raised); display:flex; align-items:center;
    justify-content:center; font-family:var(--font-mono); font-size:13px; color:var(--gold); flex-shrink:0; border:1px solid var(--line);}
  .name{font-weight:600; font-size:14px;}
  .role{font-size:12px; color:var(--text-dim);}
  .post-text{font-size:14px; line-height:1.5; color:var(--text); margin:0 0 10px;}
  .tag-row{display:flex; gap:6px; flex-wrap:wrap;}
  .tag{font-family:var(--font-mono); font-size:11px; padding:3px 8px; border-radius:6px; background:var(--surface-raised); color:var(--teal); border:1px solid var(--line);}

  .person-row{display:flex; align-items:center; gap:12px; padding:12px 4px; border-bottom:1px solid var(--line); cursor:pointer;}
  .person-row:last-child{border-bottom:none;}
  .person-info{flex:1; min-width:0;}
  .person-info .name{margin-bottom:2px; display:flex; align-items:center; gap:6px;}
  .person-info .uname{font-family:var(--font-mono); font-size:11px; color:var(--text-dim); font-weight:400;}
  .connect-btn{font-family:var(--font-mono); font-size:11px; padding:7px 12px; border-radius:8px; border:1px solid var(--gold);
    background:transparent; color:var(--gold); cursor:pointer; flex-shrink:0;}
  .connect-btn.is-friend{border-color:var(--teal); color:var(--teal);}

  /* ---------- People toolbar ---------- */
  .people-toolbar{margin-bottom:14px;}
  .filter-tabs{display:flex; gap:8px; margin-bottom:12px;}
  .filter-tab{font-family:var(--font-mono); font-size:12px; padding:7px 14px; border-radius:20px; border:1px solid var(--line);
    background:var(--surface); color:var(--text-dim); cursor:pointer;}
  .filter-tab.active{border-color:var(--gold); color:var(--gold); background:rgba(201,162,39,.08);}
  .add-friend-row{display:flex; gap:8px;}
  .add-friend-row input{flex:1; background:var(--surface); border:1px solid var(--line); border-radius:10px; padding:11px 12px;
    color:var(--text); font-family:var(--font-body); font-size:13px; outline:none;}
  .add-friend-row input:focus{border-color:var(--gold);}
  .add-friend-row input::placeholder{color:var(--text-dim);}
  .add-friend-row button{font-family:var(--font-display); font-weight:600; font-size:13px; padding:0 16px; border-radius:10px;
    border:none; background:var(--gold); color:#161200; cursor:pointer; flex-shrink:0;}
  .hint{font-size:11px; color:var(--text-dim); margin:8px 2px 0;}

  /* ---------- Chat list ---------- */
  .chat-row{display:flex; align-items:center; gap:12px; padding:12px 4px; border-bottom:1px solid var(--line); cursor:pointer;}
  .chat-row:last-child{border-bottom:none;}
  .chat-info{flex:1; min-width:0;}
  .chat-info .name{margin-bottom:2px;}
  .chat-preview{font-size:12px; color:var(--text-dim); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .chat-meta{text-align:right; flex-shrink:0;}
  .chat-time{font-size:11px; color:var(--text-dim); font-family:var(--font-mono);}
  .unread-badge{display:inline-block; background:var(--gold); color:#161200; font-size:10px; font-family:var(--font-mono);
    font-weight:600; border-radius:8px; padding:1px 6px; margin-top:4px;}

  /* ---------- Chat thread overlay ---------- */
  .chat-thread{position:absolute; inset:0; background:var(--bg); z-index:30; display:none; flex-direction:column;}
  .chat-thread.open{display:flex;}
  .chat-thread-header{display:flex; align-items:center; gap:10px; padding:16px 16px 14px; border-bottom:1px solid var(--line); flex-shrink:0;}
  .chat-back{background:none; border:none; color:var(--text); font-size:20px; cursor:pointer; padding:0 4px 0 0;}
  .chat-messages{flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:8px;}
  .msg{max-width:75%; padding:10px 13px; border-radius:14px; font-size:14px; line-height:1.4;}
  .msg.them{background:var(--surface); border:1px solid var(--line); align-self:flex-start; border-bottom-left-radius:4px;}
  .msg.me{background:var(--gold); color:#161200; align-self:flex-end; border-bottom-right-radius:4px;}
  .chat-input-row{display:flex; gap:8px; padding:12px 16px calc(12px + env(safe-area-inset-bottom)); border-top:1px solid var(--line); flex-shrink:0;}
  .chat-input-row input{flex:1; background:var(--surface); border:1px solid var(--line); border-radius:20px; padding:11px 16px;
    color:var(--text); font-family:var(--font-body); font-size:14px; outline:none;}
  .chat-input-row input:focus{border-color:var(--gold);}
  .chat-input-row button{width:40px; height:40px; border-radius:50%; border:none; background:var(--gold); color:#161200;
    font-size:15px; cursor:pointer; flex-shrink:0;}

  .profile-hero{text-align:center; padding:20px 0 8px;}
  .profile-hero .avatar{width:64px; height:64px; font-size:22px; margin:0 auto 12px; border-radius:16px;}
  .stat-row{display:flex; justify-content:center; gap:24px; margin:18px 0 6px;}
  .stat{text-align:center;}
  .stat b{display:block; font-family:var(--font-mono); font-size:17px; color:var(--gold);}
  .stat span{font-size:11px; color:var(--text-dim);}
  .empty{text-align:center; color:var(--text-dim); font-size:13px; padding:36px 20px;}

  /* ---------- Bottom nav ---------- */
  nav{position:absolute; bottom:0; left:0; right:0; display:flex; background:var(--surface);
    border-top:1px solid var(--line); padding:8px 8px calc(8px + env(safe-area-inset-bottom));}
  nav button{flex:1; background:none; border:none; color:var(--text-dim); font-family:var(--font-body);
    font-size:11px; padding:6px 0; display:flex; flex-direction:column; align-items:center; gap:4px; cursor:pointer;}
  nav button .dot{width:5px; height:5px; border-radius:50%; background:transparent;}
  nav button.active{color:var(--text);}
  nav button.active .dot{background:var(--gold);}

  /* ---------- Dev badge ---------- */
  .dev-badge{display:inline-flex; align-items:center; gap:3px; font-family:var(--font-mono); font-size:9px;
    padding:2px 6px; border-radius:6px; background:rgba(201,162,39,.14); color:var(--gold); border:1px solid rgba(201,162,39,.4);
    vertical-align:middle; white-space:nowrap;}

  /* ---------- Feed composer ---------- */
  .composer{background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:14px; margin-bottom:16px;}
  .composer textarea{width:100%; background:transparent; border:none; color:var(--text); font-family:var(--font-body);
    font-size:14px; resize:none; outline:none; min-height:44px; line-height:1.4;}
  .composer textarea::placeholder{color:var(--text-dim);}
  .composer-row{display:flex; justify-content:flex-end; margin-top:8px;}
  .composer-row button{font-family:var(--font-display); font-weight:600; font-size:13px; padding:9px 18px; border-radius:10px;
    border:none; background:var(--gold); color:#161200; cursor:pointer;}
  .composer-row button:disabled{opacity:.4; cursor:default;}
  .post-time{font-size:11px; color:var(--text-dim); font-family:var(--font-mono); margin-left:auto;}

  /* ---------- Chat toolbar / groups ---------- */
  .chat-toolbar{display:flex; align-items:center; gap:8px; margin-bottom:14px;}
  .chat-toolbar .filter-tabs{margin-bottom:0; flex:1;}
  .new-group-btn{font-family:var(--font-mono); font-size:12px; padding:7px 12px; border-radius:20px; border:1px solid var(--gold);
    background:transparent; color:var(--gold); cursor:pointer; white-space:nowrap;}
  .group-panel{background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:14px; margin-bottom:14px; display:none;}
  .group-panel.open{display:block;}
  .group-panel input[type="text"]{width:100%; background:var(--surface-raised); border:1px solid var(--line); border-radius:10px;
    padding:11px 12px; color:var(--text); font-family:var(--font-body); font-size:13px; outline:none; margin-bottom:10px;}
  .group-panel input[type="text"]:focus{border-color:var(--gold);}
  .friend-check-list{max-height:160px; overflow-y:auto; margin-bottom:10px;}
  .friend-check-row{display:flex; align-items:center; gap:10px; padding:8px 2px;}
  .friend-check-row span{font-size:13px;}
  .group-panel-actions{display:flex; gap:8px; justify-content:flex-end;}
  .group-panel-actions button{font-family:var(--font-display); font-weight:600; font-size:13px; padding:9px 16px; border-radius:10px; border:none; cursor:pointer;}
  .btn-cancel{background:var(--surface-raised); color:var(--text-dim);}
  .btn-create{background:var(--gold); color:#161200;}

  .msg-sender{font-family:var(--font-mono); font-size:10px; color:var(--text-dim); margin:0 0 3px 2px;}

  .avatar img{width:100%; height:100%; object-fit:cover; border-radius:inherit;}

  .avatar-upload-row{display:flex; justify-content:center; margin-top:12px;}
  .avatar-upload-btn{font-family:var(--font-mono); font-size:11px; padding:8px 14px; border-radius:8px; border:1px solid var(--gold);
    background:transparent; color:var(--gold); cursor:pointer;}

  /* ---------- Dev unlock ---------- */
  .dev-unlock{display:flex; gap:8px; margin-top:18px;}
  .dev-unlock input{flex:1; background:var(--surface); border:1px solid var(--line); border-radius:10px; padding:10px 12px;
    color:var(--text); font-family:var(--font-mono); font-size:12px; outline:none;}
  .dev-unlock button{font-family:var(--font-display); font-weight:600; font-size:12px; padding:0 14px; border-radius:10px;
    border:none; background:var(--surface-raised); color:var(--text); cursor:pointer;}
</style>
</head>
<body>
<div id="app">

  <!-- ONBOARDING -->
  <div id="onboarding">
    <svg class="node-graph" viewBox="0 0 280 140" fill="none">
      <line x1="60" y1="40" x2="140" y2="70" stroke="#2A3350" stroke-width="1"/>
      <line x1="140" y1="70" x2="220" y2="35" stroke="#2A3350" stroke-width="1"/>
      <line x1="140" y1="70" x2="110" y2="120" stroke="#2A3350" stroke-width="1"/>
      <line x1="140" y1="70" x2="210" y2="110" stroke="#2A3350" stroke-width="1"/>
      <line x1="60" y1="40" x2="110" y2="120" stroke="#2A3350" stroke-width="1"/>
      <circle cx="60" cy="40" r="5" fill="#2DD4BF"/>
      <circle cx="140" cy="70" r="7" fill="#C9A227"/>
      <circle cx="220" cy="35" r="5" fill="#2DD4BF"/>
      <circle cx="110" cy="120" r="5" fill="#E5626B"/>
      <circle cx="210" cy="110" r="5" fill="#2DD4BF"/>
    </svg>
    <h2>Ledger</h2>
    <p>Сеть для тех, кто шарит в крипте и хочет строить рядом с такими же. Ты — узел графа, а не просто зритель.</p>
    <button class="cta" id="enterBtn">Войти в комьюнити</button>
    <button class="ghost" id="skipBtn">Сначала посмотреть</button>
  </div>

  <!-- TICKER -->
  <div class="ticker-wrap">
    <div class="ticker" id="tickerEl"></div>
  </div>

  <!-- HEADER -->
  <header>
    <div class="eyebrow" id="screenLabel">Лента</div>
    <h1 id="screenTitle">Что происходит</h1>
    <p class="sub" id="screenSub">Обновления от людей вашей сети</p>
  </header>

  <main>
    <!-- FEED -->
    <section class="screen active" id="feed">
      <div class="composer">
        <textarea id="postInput" placeholder="Поделись чем-то с сетью..." rows="2"></textarea>
        <div class="composer-row">
          <button id="postBtn">Опубликовать</button>
        </div>
      </div>
      <div id="feedList"><div class="empty">Загрузка…</div></div>
    </section>

    <!-- PEOPLE -->
    <section class="screen" id="people">
      <div class="people-toolbar">
        <div class="filter-tabs">
          <button class="filter-tab active" data-filter="all">Все</button>
          <button class="filter-tab" data-filter="friends">Друзья</button>
        </div>
        <div class="add-friend-row">
          <input type="text" id="addFriendInput" placeholder="@username в Telegram">
          <button id="addFriendBtn">Добавить</button>
        </div>
        <div class="hint" id="addFriendHint"></div>
      </div>
      <div class="card" id="peopleList" style="padding:6px 4px;"></div>
    </section>

    <!-- CHAT -->
    <section class="screen" id="chat">
      <div class="chat-toolbar">
        <div class="filter-tabs">
          <button class="filter-tab active" data-chat-filter="dm">Личные</button>
          <button class="filter-tab" data-chat-filter="groups">Группы</button>
        </div>
        <button class="new-group-btn" id="newGroupBtn">+ Группа</button>
      </div>
      <div class="group-panel" id="groupPanel">
        <input type="text" id="groupNameInput" placeholder="Название группы">
        <div class="friend-check-list" id="friendCheckList"></div>
        <div class="group-panel-actions">
          <button class="btn-cancel" id="groupCancelBtn">Отмена</button>
          <button class="btn-create" id="groupCreateBtn">Создать</button>
        </div>
      </div>
      <div class="card" id="chatList" style="padding:6px 4px;"></div>
    </section>

    <!-- PROFILE -->
    <section class="screen" id="profile">
      <div class="profile-hero">
        <div class="avatar" id="profileAvatar">Я</div>
        <div class="avatar-upload-row">
          <button class="avatar-upload-btn" id="avatarUploadBtn">Изменить аватар</button>
          <input type="file" id="avatarFileInput" accept="image/*" style="display:none;">
        </div>
        <div class="hint" id="avatarHint" style="margin-top:6px;"></div>
        <div class="name" id="profileName" style="font-size:17px;">Твой профиль</div>
        <div class="role">Настрой, кем тебя видят другие</div>
        <div class="stat-row">
          <div class="stat"><b id="statFriends">0</b><span>связи</span></div>
          <div class="stat"><b id="statPosts">0</b><span>посты</span></div>
          <div class="stat"><b>—</b><span>уровень</span></div>
        </div>
      </div>
      <div class="empty">Профиль пока пустой — это первая версия аппы.<br>Дальше добавим настройку интересов и связей.</div>
      <div class="dev-unlock">
        <input type="text" id="devCodeInput" placeholder="Код разработчика (если он у тебя есть)">
        <button id="devCodeBtn">ОК</button>
      </div>
      <div class="hint" id="devCodeHint"></div>
    </section>
  </main>

  <!-- NAV -->
  <nav>
    <button class="nav-btn active" data-screen="feed" data-label="Лента" data-title="Что происходит" data-sub="Обновления от людей вашей сети"><span class="dot"></span>Лента</button>
    <button class="nav-btn" data-screen="chat" data-label="Чат" data-title="Сообщения" data-sub="Общение с людьми из сети"><span class="dot"></span>Чат</button>
    <button class="nav-btn" data-screen="people" data-label="Люди" data-title="Комьюнити" data-sub="Те, кто уже в сети"><span class="dot"></span>Люди</button>
    <button class="nav-btn" data-screen="profile" data-label="Профиль" data-title="Ты" data-sub="Твоя карточка в сети"><span class="dot"></span>Профиль</button>
  </nav>

  <!-- CHAT THREAD OVERLAY -->
  <div class="chat-thread" id="chatThread">
    <div class="chat-thread-header">
      <button class="chat-back" id="chatBackBtn">←</button>
      <div class="avatar" id="threadAvatar"></div>
      <div><div class="name" id="threadName"></div><div class="role" id="threadRole"></div></div>
    </div>
    <div class="chat-messages" id="chatMessages"></div>
    <div class="chat-input-row">
      <input type="text" id="chatInput" placeholder="Сообщение...">
      <button id="chatSendBtn">➤</button>
    </div>
  </div>

</div>

<script>
  // Telegram WebApp init
  const tg = window.Telegram ? window.Telegram.WebApp : null;
  if (tg) {
    tg.ready();
    tg.expand();
    if (tg.setHeaderColor) { try { tg.setHeaderColor('#0F1420'); } catch(e){} }
    if (tg.setBackgroundColor) { try { tg.setBackgroundColor('#0F1420'); } catch(e){} }
  }

  const DEV_CODE = 'ledger-dev-2026';

  // Ticker content (duplicated for seamless loop)
  const tickerItems = [
    '<span class="up">● @satoshi_kz присоединился</span>',
    '<span class="gold">● 3 новых связи в сети</span>',
    '<span class="up">● @anna_web3 нашла со-фаундера</span>',
    '<span>● новый пост от Данияра Р.</span>',
    '<span class="gold">● 12 человек онлайн сейчас</span>'
  ];
  const tickerEl = document.getElementById('tickerEl');
  tickerEl.innerHTML = tickerItems.join('') + tickerItems.join('');

  // Onboarding — shown only if the profile hasn't completed it before
  document.getElementById('enterBtn').addEventListener('click', () => completeOnboarding());
  document.getElementById('skipBtn').addEventListener('click', () => completeOnboarding());
  async function completeOnboarding(){
    document.getElementById('onboarding').classList.remove('show');
    if (tg && tg.HapticFeedback) tg.HapticFeedback.impactOccurred('light');
    if (me) await db.from('profiles').update({ onboarded: true }).eq('tg_id', me.tg_id);
  }

  // Nav switching — instant screen swap, background refresh (no blocking spinner on repeat visits)
  document.querySelectorAll('.nav-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.classList.contains('active')) return; // ignore re-taps, avoids redundant refetch/jank
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      document.getElementById(btn.dataset.screen).classList.add('active');
      document.getElementById('screenLabel').textContent = btn.dataset.label;
      document.getElementById('screenTitle').textContent = btn.dataset.title;
      document.getElementById('screenSub').textContent = btn.dataset.sub;
      if (tg && tg.HapticFeedback) tg.HapticFeedback.selectionChanged();
      if (btn.dataset.screen === 'chat') renderChatList();
      if (btn.dataset.screen === 'people') renderPeople();
      if (btn.dataset.screen === 'feed') renderFeed();
    });
  });

  // ---------- Supabase connection ----------
  const SUPABASE_URL = 'https://sxjuvyventfnldeoatcz.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_y-8Qqrz6V07szUm8UMwSYA_YQJwA_2a';
  const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

  let me = null; // { tg_id, username, first_name, avatar_initials, is_developer }
  let peopleFilter = 'all';
  let chatFilter = 'dm';
  let activeThreadId = null;   // friend tg_id OR group id, depending on activeThreadType
  let activeThreadType = null; // 'dm' | 'group'
  let friendIds = new Set();
  let profilesCache = new Map(); // tg_id -> profile row
  let groupsCache = new Map();   // group id -> group row

  function initials(str){
    const clean = (str || '?').replace('@','');
    return clean.slice(0,2).toUpperCase();
  }

  function badgeHtml(p){
    return p && p.is_developer ? ' <span class="dev-badge">⚡ Разработчик</span>' : '';
  }

  function avatarInner(p){
    if (p && p.avatar_url) return `<img src="${p.avatar_url}" alt="">`;
    return (p && (p.avatar_initials || initials(p.first_name))) || '?';
  }

  function timeAgo(iso){
    const diffMs = Date.now() - new Date(iso).getTime();
    const min = Math.floor(diffMs / 60000);
    if (min < 1) return 'сейчас';
    if (min < 60) return min + ' мин назад';
    const hrs = Math.floor(min / 60);
    if (hrs < 24) return hrs + ' ч назад';
    return new Date(iso).toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' });
  }

  function escapeHtml(str){
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  // renders a list container without a blank "loading" flash on repeat calls —
  // only shows the loading placeholder the very first time a container is empty
  function softRender(el, html, emptyPlaceholder){
    if (!el.dataset.loadedOnce && !html){
      el.innerHTML = emptyPlaceholder;
      return;
    }
    el.innerHTML = html || emptyPlaceholder;
    el.dataset.loadedOnce = '1';
  }

  // ---------- Identify current user ----------
  async function initUser(){
    const tgUser = tg && tg.initDataUnsafe && tg.initDataUnsafe.user ? tg.initDataUnsafe.user : null;
    let tg_id, username, first_name;
    if (tgUser){
      tg_id = tgUser.id;
      username = tgUser.username ? '@' + tgUser.username : ('@id' + tgUser.id);
      first_name = tgUser.first_name || 'Без имени';
    } else {
      tg_id = Date.now();
      username = '@guest_' + Math.floor(Math.random()*9999);
      first_name = 'Гость';
      const banner = document.createElement('div');
      banner.style.cssText = 'background:var(--surface-raised);color:var(--text-dim);font-size:11px;padding:8px 20px;text-align:center;border-bottom:1px solid var(--line);';
      banner.textContent = 'Тестовый режим вне Telegram — аккаунт временный, друзья не синхронизируются между устройствами';
      document.querySelector('.ticker-wrap').after(banner);
    }
    const avatar_initials = initials(first_name || username);

    // Look up existing profile first so we know whether onboarding was already completed
    const { data: existing } = await db.from('profiles').select('*').eq('tg_id', tg_id).maybeSingle();

    await db.from('profiles').upsert({
      tg_id, username, first_name, avatar_initials,
      onboarded: existing ? existing.onboarded : false,
      is_developer: existing ? existing.is_developer : false
    }, { onConflict: 'tg_id' });

    me = {
      tg_id, username, first_name, avatar_initials,
      avatar_url: existing ? existing.avatar_url : null,
      onboarded: existing ? existing.onboarded : false,
      is_developer: existing ? existing.is_developer : false
    };

    if (!me.onboarded){
      document.getElementById('onboarding').classList.add('show');
    }

    profilesCache.set(me.tg_id, me);
    renderProfileHeader();
  }

  function renderProfileHeader(){
    document.getElementById('profileAvatar').innerHTML = avatarInner(me);
    document.getElementById('profileName').innerHTML = me.first_name + ' ' + me.username + badgeHtml(me);
    document.getElementById('statFriends').textContent = friendIds.size;
  }

  // ---------- Avatar upload ----------
  document.getElementById('avatarUploadBtn').addEventListener('click', () => document.getElementById('avatarFileInput').click());
  document.getElementById('avatarFileInput').addEventListener('change', handleAvatarUpload);

  async function handleAvatarUpload(e){
    const file = e.target.files[0];
    if (!file) return;
    const hint = document.getElementById('avatarHint');
    if (!file.type.startsWith('image/')){
      hint.textContent = 'Нужен файл изображения (jpg, png и т.п.).';
      hint.style.color = 'var(--red)';
      return;
    }
    if (file.size > 5 * 1024 * 1024){
      hint.textContent = 'Файл слишком большой — максимум 5 МБ.';
      hint.style.color = 'var(--red)';
      return;
    }
    hint.textContent = 'Загружаю…';
    hint.style.color = 'var(--text-dim)';

    const ext = (file.name.split('.').pop() || 'jpg').toLowerCase();
    const path = `${me.tg_id}.${ext}`;
    const { error: upErr } = await db.storage.from('avatars').upload(path, file, { upsert: true, contentType: file.type });
    if (upErr){
      hint.textContent = 'Не удалось загрузить: ' + upErr.message;
      hint.style.color = 'var(--red)';
      return;
    }
    const { data: pub } = db.storage.from('avatars').getPublicUrl(path);
    const url = pub.publicUrl + '?t=' + Date.now(); // cache-bust so the new photo shows immediately

    await db.from('profiles').update({ avatar_url: url }).eq('tg_id', me.tg_id);
    me.avatar_url = url;
    profilesCache.set(me.tg_id, me);

    hint.textContent = 'Аватар обновлён ✅';
    hint.style.color = 'var(--teal)';
    renderProfileHeader();
    renderPeople();
    renderChatList();
    renderFeed();
  }

  // ---------- Developer badge unlock ----------
  document.getElementById('devCodeBtn').addEventListener('click', unlockDeveloper);
  document.getElementById('devCodeInput').addEventListener('keydown', (e) => { if (e.key === 'Enter') unlockDeveloper(); });
  async function unlockDeveloper(){
    const input = document.getElementById('devCodeInput');
    const hint = document.getElementById('devCodeHint');
    if (input.value.trim() !== DEV_CODE){
      hint.textContent = 'Неверный код.';
      hint.style.color = 'var(--red)';
      return;
    }
    await db.from('profiles').update({ is_developer: true }).eq('tg_id', me.tg_id);
    me.is_developer = true;
    input.value = '';
    document.querySelector('.dev-unlock').style.display = 'none';
    hint.textContent = 'Метка разработчика активирована ⚡';
    hint.style.color = 'var(--teal)';
    renderProfileHeader();
  }

  // ---------- Feed (everyone can post) ----------
  document.getElementById('postBtn').addEventListener('click', publishPost);
  async function publishPost(){
    const input = document.getElementById('postInput');
    const btn = document.getElementById('postBtn');
    const text = input.value.trim();
    if (!text) return;
    btn.disabled = true;
    await db.from('posts').insert({ author_id: me.tg_id, text });
    input.value = '';
    btn.disabled = false;
    if (tg && tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('success');
    renderFeed();
  }

  async function renderFeed(){
    const el = document.getElementById('feedList');
    const { data } = await db.from('posts')
      .select('*, author:profiles!posts_author_id_fkey(first_name, username, avatar_initials, is_developer)')
      .order('created_at', { ascending: false }).limit(50);

    const html = (data || []).map(post => {
      const a = post.author || {};
      return `
      <div class="card">
        <div class="card-head">
          <div class="avatar">${avatarInner(a)}</div>
          <div>
            <div class="name">${a.first_name || 'Без имени'}${badgeHtml(a)}</div>
            <div class="role">${a.username || ''}</div>
          </div>
          <div class="post-time">${timeAgo(post.created_at)}</div>
        </div>
        <p class="post-text">${escapeHtml(post.text)}</p>
      </div>`;
    }).join('');

    softRender(el, html, '<div class="empty">Постов пока нет — напиши первым.</div>');
  }

  // ---------- People (Все / Друзья) ----------
  async function loadFriendIds(){
    const { data } = await db.from('friendships').select('friend_id').eq('user_id', me.tg_id);
    friendIds = new Set((data || []).map(r => r.friend_id));
  }

  async function renderPeople(){
    const list = document.getElementById('peopleList');
    await loadFriendIds();
    renderProfileHeader();

    let rows = [];
    if (peopleFilter === 'friends'){
      const ids = [...friendIds];
      if (ids.length){
        const { data } = await db.from('profiles').select('*').in('tg_id', ids);
        rows = data || [];
      }
    } else {
      const { data } = await db.from('profiles').select('*').neq('tg_id', me.tg_id).order('created_at', { ascending: false }).limit(50);
      rows = data || [];
    }
    rows.forEach(p => profilesCache.set(p.tg_id, p));

    const emptyMsg = peopleFilter === 'friends'
      ? '<div class="empty">Пока нет друзей.<br>Добавь кого-то по username выше.</div>'
      : '<div class="empty">Пока в сети больше никого нет.<br>Позови друзей открыть аппу — тогда они появятся здесь.</div>';

    const html = rows.map(p => {
      const isFriend = friendIds.has(p.tg_id);
      return `
      <div class="person-row" data-open-chat="${isFriend ? p.tg_id : ''}">
        <div class="avatar">${avatarInner(p)}</div>
        <div class="person-info">
          <div class="name">${p.first_name}${badgeHtml(p)} <span class="uname">${p.username}</span></div>
          <div class="role">${isFriend ? 'В друзьях' : 'Участник сети'}</div>
        </div>
        <button class="connect-btn ${isFriend ? 'is-friend' : ''}" data-friend-toggle="${p.tg_id}">
          ${isFriend ? 'Друг ✓' : 'Добавить в друзья'}
        </button>
      </div>`;
    }).join('');

    softRender(list, html, emptyMsg);

    list.querySelectorAll('[data-friend-toggle]').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const friendId = Number(btn.dataset.friendToggle);
        if (friendIds.has(friendId)) return;
        btn.textContent = 'Друг ✓';
        btn.classList.add('is-friend');
        await addFriendById(friendId);
        renderPeople();
        renderChatList();
      });
    });

    list.querySelectorAll('[data-open-chat]').forEach(row => {
      const id = row.dataset.openChat;
      if (id) row.addEventListener('click', () => openDMThread(Number(id)));
    });
  }

  async function addFriendById(friendId){
    await db.from('friendships').upsert({ user_id: me.tg_id, friend_id: friendId }, { onConflict: 'user_id,friend_id' });
    friendIds.add(friendId);
    if (tg && tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('success');
  }

  document.getElementById('addFriendBtn').addEventListener('click', addFriendByUsername);
  document.getElementById('addFriendInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') addFriendByUsername();
  });

  async function addFriendByUsername(){
    const input = document.getElementById('addFriendInput');
    const hint = document.getElementById('addFriendHint');
    let value = input.value.trim();
    if (!value) return;
    if (!value.startsWith('@')) value = '@' + value;
    const usernamePattern = /^@[a-zA-Z0-9_]{5,32}$/;
    if (!usernamePattern.test(value)){
      hint.textContent = 'Похоже, это не похоже на username Telegram (например, @nurlan_b)';
      hint.style.color = 'var(--red)';
      return;
    }
    if (value.toLowerCase() === me.username.toLowerCase()){
      hint.textContent = 'Это твой собственный username 🙂';
      hint.style.color = 'var(--red)';
      return;
    }
    const { data } = await db.from('profiles').select('*').ilike('username', value).limit(1);
    if (!data || data.length === 0){
      hint.textContent = 'Такого пользователя пока нет в аппе — он должен хотя бы раз открыть её в Telegram, тогда сможешь добавить.';
      hint.style.color = 'var(--red)';
      return;
    }
    const person = data[0];
    profilesCache.set(person.tg_id, person);
    await addFriendById(person.tg_id);
    input.value = '';
    hint.textContent = `${person.first_name} добавлен(а) в друзья — теперь можно писать в «Чат».`;
    hint.style.color = 'var(--teal)';
    renderPeople();
    renderChatList();
  }

  document.querySelectorAll('#people .filter-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('#people .filter-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      peopleFilter = tab.dataset.filter;
      renderPeople();
    });
  });

  // ---------- Chat: DM list + Groups list ----------
  document.querySelectorAll('#chat .filter-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('#chat .filter-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      chatFilter = tab.dataset.chatFilter;
      renderChatList();
    });
  });

  async function renderChatList(){
    if (chatFilter === 'groups') return renderGroupList();
    const list = document.getElementById('chatList');
    await loadFriendIds();
    const ids = [...friendIds];
    if (ids.length === 0){
      softRender(list, '', '<div class="empty">Переписок пока нет.<br>Добавь кого-то в друзья на вкладке «Люди».</div>');
      return;
    }
    const { data: friends } = await db.from('profiles').select('*').in('tg_id', ids);
    (friends || []).forEach(p => profilesCache.set(p.tg_id, p));

    const rows = await Promise.all((friends || []).map(async (f) => {
      const { data: lastMsgs } = await db.from('messages').select('*')
        .or(`and(sender_id.eq.${me.tg_id},receiver_id.eq.${f.tg_id}),and(sender_id.eq.${f.tg_id},receiver_id.eq.${me.tg_id})`)
        .order('created_at', { ascending: false }).limit(1);
      return { profile: f, last: lastMsgs && lastMsgs[0] };
    }));

    rows.sort((a, b) => {
      const ta = a.last ? new Date(a.last.created_at).getTime() : 0;
      const tb = b.last ? new Date(b.last.created_at).getTime() : 0;
      return tb - ta;
    });

    const html = rows.map(({ profile: f, last }) => `
      <div class="chat-row" data-open-chat="${f.tg_id}">
        <div class="avatar">${avatarInner(f)}</div>
        <div class="chat-info">
          <div class="name">${f.first_name}${badgeHtml(f)}</div>
          <div class="chat-preview">${last ? (last.sender_id === me.tg_id ? 'Вы: ' : '') + escapeHtml(last.text) : 'Пока нет сообщений — напиши первым'}</div>
        </div>
        <div class="chat-meta">
          <div class="chat-time">${last ? new Date(last.created_at).toLocaleTimeString('ru-RU', {hour:'2-digit', minute:'2-digit'}) : ''}</div>
        </div>
      </div>
    `).join('');

    softRender(list, html, '<div class="empty">Переписок пока нет.</div>');

    list.querySelectorAll('[data-open-chat]').forEach(row => {
      row.addEventListener('click', () => openDMThread(Number(row.dataset.openChat)));
    });
  }

  async function renderGroupList(){
    const list = document.getElementById('chatList');
    const { data: memberships } = await db.from('group_members').select('group_id').eq('user_id', me.tg_id);
    const groupIds = (memberships || []).map(m => m.group_id);
    if (groupIds.length === 0){
      softRender(list, '', '<div class="empty">Групп пока нет.<br>Нажми «+ Группа» выше, чтобы создать.</div>');
      return;
    }
    const { data: groups } = await db.from('groups').select('*').in('id', groupIds);
    (groups || []).forEach(g => groupsCache.set(g.id, g));

    const rows = await Promise.all((groups || []).map(async (g) => {
      const { data: lastMsgs } = await db.from('messages').select('*').eq('group_id', g.id)
        .order('created_at', { ascending: false }).limit(1);
      const { count } = await db.from('group_members').select('*', { count: 'exact', head: true }).eq('group_id', g.id);
      return { group: g, last: lastMsgs && lastMsgs[0], count: count || 0 };
    }));

    rows.sort((a, b) => {
      const ta = a.last ? new Date(a.last.created_at).getTime() : 0;
      const tb = b.last ? new Date(b.last.created_at).getTime() : 0;
      return tb - ta;
    });

    const html = rows.map(({ group: g, last, count }) => `
      <div class="chat-row" data-open-group="${g.id}">
        <div class="avatar">${g.avatar_initials || initials(g.name)}</div>
        <div class="chat-info">
          <div class="name">${g.name}</div>
          <div class="chat-preview">${last ? escapeHtml(last.text) : count + ' участник(ов)'}</div>
        </div>
        <div class="chat-meta">
          <div class="chat-time">${last ? new Date(last.created_at).toLocaleTimeString('ru-RU', {hour:'2-digit', minute:'2-digit'}) : ''}</div>
        </div>
      </div>
    `).join('');

    softRender(list, html, '<div class="empty">Групп пока нет.</div>');

    list.querySelectorAll('[data-open-group]').forEach(row => {
      row.addEventListener('click', () => openGroupThread(Number(row.dataset.openGroup)));
    });
  }

  // ---------- Group creation ----------
  const groupPanel = document.getElementById('groupPanel');
  document.getElementById('newGroupBtn').addEventListener('click', async () => {
    const opening = !groupPanel.classList.contains('open');
    groupPanel.classList.toggle('open');
    if (opening) await populateFriendCheckList();
  });
  document.getElementById('groupCancelBtn').addEventListener('click', () => {
    groupPanel.classList.remove('open');
  });

  async function populateFriendCheckList(){
    await loadFriendIds();
    const box = document.getElementById('friendCheckList');
    const ids = [...friendIds];
    if (ids.length === 0){
      box.innerHTML = '<div class="empty" style="padding:12px 0;">Сначала добавь друзей — группу можно создать только с ними.</div>';
      return;
    }
    const { data } = await db.from('profiles').select('*').in('tg_id', ids);
    box.innerHTML = (data || []).map(p => `
      <label class="friend-check-row">
        <input type="checkbox" value="${p.tg_id}">
        <span>${p.first_name} <span class="uname">${p.username}</span></span>
      </label>
    `).join('');
  }

  document.getElementById('groupCreateBtn').addEventListener('click', async () => {
    const nameInput = document.getElementById('groupNameInput');
    const name = nameInput.value.trim();
    if (!name){ nameInput.focus(); return; }
    const checked = [...document.querySelectorAll('#friendCheckList input[type="checkbox"]:checked')].map(c => Number(c.value));

    const { data: created, error } = await db.from('groups')
      .insert({ name, avatar_initials: initials(name), creator_id: me.tg_id })
      .select().single();
    if (error || !created) return;

    const members = [me.tg_id, ...checked].map(uid => ({ group_id: created.id, user_id: uid }));
    await db.from('group_members').insert(members);

    groupsCache.set(created.id, created);
    nameInput.value = '';
    groupPanel.classList.remove('open');
    document.querySelectorAll('#chat .filter-tab').forEach(t => t.classList.remove('active'));
    document.querySelector('#chat .filter-tab[data-chat-filter="groups"]').classList.add('active');
    chatFilter = 'groups';
    await renderGroupList();
    openGroupThread(created.id);
  });

  // ---------- Chat thread (shared overlay for DM + groups) ----------
  async function openDMThread(friendId){
    activeThreadType = 'dm';
    activeThreadId = friendId;
    let profile = profilesCache.get(friendId);
    if (!profile){
      const { data } = await db.from('profiles').select('*').eq('tg_id', friendId).maybeSingle();
      profile = data;
      if (profile) profilesCache.set(friendId, profile);
    }
    document.getElementById('threadAvatar').innerHTML = avatarInner(profile);
    document.getElementById('threadName').innerHTML = (profile ? profile.first_name : '...') + badgeHtml(profile);
    document.getElementById('threadRole').textContent = profile ? profile.username : '';
    document.getElementById('chatThread').classList.add('open');
    await renderMessages();
  }

  async function openGroupThread(groupId){
    activeThreadType = 'group';
    activeThreadId = groupId;
    let group = groupsCache.get(groupId);
    if (!group){
      const { data } = await db.from('groups').select('*').eq('id', groupId).maybeSingle();
      group = data;
      if (group) groupsCache.set(groupId, group);
    }
    document.getElementById('threadAvatar').innerHTML = avatarInner(group);
    document.getElementById('threadName').textContent = group ? group.name : '...';
    document.getElementById('threadRole').textContent = 'Группа';
    document.getElementById('chatThread').classList.add('open');
    await renderMessages();
  }

  async function renderMessages(){
    const box = document.getElementById('chatMessages');
    let query;
    if (activeThreadType === 'group'){
      query = db.from('messages').select('*, sender:profiles!messages_sender_id_fkey(first_name, is_developer)')
        .eq('group_id', activeThreadId).order('created_at', { ascending: true });
    } else {
      query = db.from('messages').select('*')
        .or(`and(sender_id.eq.${me.tg_id},receiver_id.eq.${activeThreadId}),and(sender_id.eq.${activeThreadId},receiver_id.eq.${me.tg_id})`)
        .order('created_at', { ascending: true });
    }
    const { data } = await query;

    const html = (data || []).map(m => {
      const mine = m.sender_id === me.tg_id;
      const senderLabel = (activeThreadType === 'group' && !mine && m.sender)
        ? `<div class="msg-sender">${m.sender.first_name}${badgeHtml(m.sender)}</div>` : '';
      return `${senderLabel}<div class="msg ${mine ? 'me' : 'them'}">${escapeHtml(m.text)}</div>`;
    }).join('');

    box.innerHTML = html || '<div class="empty">Сообщений пока нет — напиши первым</div>';
    box.scrollTop = box.scrollHeight;
  }

  document.getElementById('chatBackBtn').addEventListener('click', () => {
    document.getElementById('chatThread').classList.remove('open');
    activeThreadId = null;
    activeThreadType = null;
    renderChatList();
  });

  async function sendCurrentMessage(){
    const input = document.getElementById('chatInput');
    const text = input.value.trim();
    if (!text || !activeThreadId) return;
    input.value = '';
    if (activeThreadType === 'group'){
      await db.from('messages').insert({ sender_id: me.tg_id, group_id: activeThreadId, text });
    } else {
      await db.from('messages').insert({ sender_id: me.tg_id, receiver_id: activeThreadId, text });
    }
    if (tg && tg.HapticFeedback) tg.HapticFeedback.impactOccurred('light');
    await renderMessages();
  }

  document.getElementById('chatSendBtn').addEventListener('click', sendCurrentMessage);
  document.getElementById('chatInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') sendCurrentMessage();
  });

  // ---------- Realtime: live-update open thread / chat list / feed ----------
  function subscribeRealtime(){
    db.channel('messages-changes')
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages' }, (payload) => {
        const m = payload.new;
        const involvesMeDM = m.sender_id === me.tg_id || m.receiver_id === me.tg_id;
        const involvesGroup = !!m.group_id;
        if (!involvesMeDM && !involvesGroup) return;
        if (activeThreadType === 'dm' && (m.sender_id === activeThreadId || m.receiver_id === activeThreadId)) renderMessages();
        if (activeThreadType === 'group' && m.group_id === activeThreadId) renderMessages();
        if (document.getElementById('chat').classList.contains('active')) renderChatList();
      })
      .subscribe();

    db.channel('posts-changes')
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'posts' }, () => {
        if (document.getElementById('feed').classList.contains('active')) renderFeed();
      })
      .subscribe();
  }

  // ---------- Boot ----------
  (async function boot(){
    await initUser();
    await renderFeed();
    await renderPeople();
    await renderChatList();
